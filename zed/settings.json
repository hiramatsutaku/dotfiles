{
  "diff_view_style": "unified",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "max",
        "mode": "bypassPermissions",
        "model": "default"
      },
      "favorite_config_option_values": {
        "effort": [
          "max",
          "xhigh",
          "high",
          "medium"
        ]
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "default_model": {
      "effort": "high",
      "provider": "anthropic",
      "model": "claude-opus-4-7-latest",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "base_keymap": "Emacs",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Colorizer Pro",
  },
  "project_panel": {
    "dock": "right",
    "auto_reveal_entries": true,
  },
}
